{
  "manifest_version": 2,
  "name": "Magic Mail",
  "version": "1.1",
  "description": "Magic Mail is a Thunderbird extension that helps you to reply your emails more efficiently.",
  "author": "Al Shimbil Khan",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "messagesRead",
    "compose",
    "compose.send",
    "storage",
    "notifications",
    "alarms",
    "menus"
  ],
  "message_display_action": {
    "default_title": "Reply With",
    "default_popup": "popup/message_action.html",
    "default_icon": "icons/icon-96.png"
  },
  "compose_action": {
    "default_title": "Advance Options",
    "default_popup": "popup/compose_popup.html",
    "default_icon": "icons/icon-96.png"
  },
  "browser_action": {
    "default_title": "Magic Mail",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon-96.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "services/storage-service.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "shimbilmax@gmail.com",
      "strict_min_version": "115.0"
    }
  }
}